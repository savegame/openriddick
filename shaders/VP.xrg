					DP4 R3.z, R4, c[$TEXPARAM6+2];
					DP4 R3.w, R4, c[$TEXPARAM6+3];
				"
			}

			*if_texgen6_screen
			"
				MUL r4, c93, r12.w
				MAD r3, r12, c92, r4
			"

			*if_texgen6_normalmap
			"
				MOV R3, R9;
			"
			*if_texgen6_tang_u
			"
				MOV R3, R0;
			"
			*if_texgen6_tang_v
			"
				MOV R3, R1;
			"

			*if_texgen6_reflection
			"
				ADD R4, R8, c[$BASE+7];
				DP4 R3.x, R4, c[$BASE+4];
				DP4 R3.y, R4, c[$BASE+5];
				DP4 R3.z, R4, c[$BASE+6];
				MOV R3.w, c[$BASE+8].x;
				DP3 R4.x, R9, c[$BASE+4];
				DP3 R4.y, R9, c[$BASE+5];
				DP3 R4.z, R9, c[$BASE+6];
				MOV R4.w, c[$BASE+8].x;
				DP3 R3.w, -R3, R4;
				ADD R3.w, R3.w, R3.w;
				MUL R4, R4, R3.wwww;
				ADD R3, R3, R4;
				MOV R3.w, c[$BASE+8].x;
			"

			*if_texgen6_env
			{
				*if_TextureTrans6
				" 
					MUL R3, $TEXINPUT6, c[$TEXTURETRANS6];
					ADD R3, R3, c[$TEXTURETRANS6+1];
				"
				*ifnot_TextureTrans3
				"
					MOV R3, $TEXINPUT6;
				"
				*Post
				"
					MOV R3, $TEXINPUT6;
					DP3 R3.x, R9, c[$BASE+4];
					DP3 R3.y, -R9, c[$BASE+5];
					MUL R3, R3, c[$BASE+8].zzzz;
					ADD R3, R3, c[$BASE+8].zzzz;
				"
			}

                        /*
			*if_texgen6_Lighting
			"
				ADD R4, c[$TEXPARAM6+0], -R8;
				DP3 R3.w, R4, R4;
				RSQ R3.z, R3.w;
				RCP R3.z, R3.z;
				MUL R3.z, c[$TEXPARAM6+0].wwww, -R3.z;
				ADD R3.z, R3.z, c[$BASE+8].yyyy;
				MAX R3.z, R3.z, c[$BASE+8].x;
				MUL R4.w, R3.w, R3.z;
				MUL R4.xyz, R4, R4.w;
				MUL R3, c[$TEXPARAM6+1], R3.z;
			"
			*/
			*if_texgen6_Lighting_Nonormal
			"
				ADD R4, c[$TEXPARAM6+0], -R8;
				DP3 R3.w, R4, R4;
				RSQ R3.z, R3.w;
				RCP R3.z, R3.z;
				MUL R3.z, c[$TEXPARAM6+0].wwww, -R3.z;
				ADD R3.z, R3.z, c[$BASE+8].yyyy;
				MAX R3.z, R3.z, c[$BASE+8].x;
				MUL R3, c[$TEXPARAM6+1], R3.z;
			"

			*if_texgen6_Lighting
			"
				ADD R4, c[$TEXPARAM6+0], -R8;
				DP3 R3.w, R4, R4;
				RSQ R3.w, R3.w;
				RCP R3.z, R3.w;
				MUL R3.z, c[$TEXPARAM6+0].wwww, -R3.z;
				ADD R3.z, R3.z, c[$BASE+8].yyyy;
				MAX R3.z, R3.z, c[$BASE+8].x;
				MUL R4.w, R3.w, R3.z;
				MUL R4.xyz, R4, R4.w;
  			        DP3 R3.x, R9, R4;
  			        MAX R3.x, R3.x, c[$BASE+8].x;
  		 	        MUL R3.xyz, R3.xxxx, c[$TEXPARAM6+1];
  		 	        MOV R3.w, c[$BASE+8].y;
			"
			
			*if_texgen6_LightField
			"
                                MAX R5, R9,c[$BASE+8].xxxx;
                                MAX R4, -R9,c[$BASE+8].xxxx;
                                MUL R3.xyz, R4.x, c[$TEXPARAM6+0];
                                MAD R3.xyz, R4.y, c[$TEXPARAM6+2],R3;
                                MAD R3.xyz, R4.z, c[$TEXPARAM6+4],R3;
                                MAD R3.xyz, R5.x, c[$TEXPARAM6+1],R3;
                                MAD R3.xyz, R5.y, c[$TEXPARAM6+3],R3;
                                MAD R3.xyz, R5.z, c[$TEXPARAM6+5],R3;
                                
                                ADD R3, R3,R3;
                                MOV R3.w, c[$BASE+8].y;
			"

			*if_texgen6_tslv
			"
				ADD R4, c[$TEXPARAM6+0], -R8;
				DP3 R3.x, R9, R4;
				DP3 R3.y, R1, R4;
				DP3 R3.z, R0, R4;
				MUL R3.xyz, R3, c[$TEXPARAM6+0].wwww;
				MOV R3.w, c[$BASE+8].x;
			"
			
			*if_texgen6_depthoffset
			{
				*if_TextureTrans6
				" 
					MUL R5, $TEXINPUT6, c[$TEXTURETRANS6];
					ADD R5, R5, c[$TEXTURETRANS6+1];
				"
				*ifnot_TextureTrans6
				"
					MOV R5, $TEXINPUT6;
				"
				*Post
				"
				    SUB R3,c[$TEXPARAM6+0],R8;
				    DP3 R3.w,R3,R3;
				    RSQ R3.w,R3.w;
				    MUL R3,R3,R3.w;
				    DP3 R4.x,R3,R0;
				    DP3 R4.y,R3,R1;
				    DP3 R4.w,R3,R9;
				    RCP R4.w,R4.w;
				    MUL R3,R4,c[$TEXPARAM6+1];
				    MAD R3,R3,R4.w,R5;
				 "
			}

			*if_texgen6_mspos
			"
				MOV @O_TEX6, R8;
			"


			*if_texgen6_vspos
			"
				ADD R4, R8, c[$BASE+7];
				DP4 R3.x, R4, c[$BASE+4];
				DP4 R3.y, R4, c[$BASE+5];
				DP4 R3.z, R4, c[$BASE+6];
				MOV R3.w, c[$BASE+8].y;
			"

			*if_texgen6_constant
			"
				MOV @O_TEX6, c[$TEXPARAM6+0];
			"
			
			*ifnot_texgen6_constant {
			*ifnot_texgen6_mspos
			{
				*if_texmatrix6
				"
					DP4 @O_TEX6.x, R3, c[$TEXMATRIX6+0];
					DP4 @O_TEX6.y, R3, c[$TEXMATRIX6+1];
					DP4 @O_TEX6.z, R3, c[$TEXMATRIX6+2];
					DP4 @O_TEX6.w, R3, c[$TEXMATRIX6+3];
				"

				*ifnot_texmatrix6
				"
					MOV @O_TEX6, R3;
				"
			}}
		}
	}

	// ----------------------------------------------------------------
	*ifnot_texgen7_void
	{
		*if_texgen7_null
		"
			MOV @O_TEX7.x, c[$BASE+8].x;
		"
		*if_texgen7_texcoord
		{
			*if_texmatrix7
			{
				*if_TextureTrans7
				" 
					MUL R4, $TEXINPUT7, c[$TEXTURETRANS7];
					ADD R4, R4, c[$TEXTURETRANS7+1];
					DP4 @O_TEX7.x, R4, c[$TEXMATRIX7+0];
					DP4 @O_TEX7.y, R4, c[$TEXMATRIX7+1];
					DP4 @O_TEX7.z, R4, c[$TEXMATRIX7+2];
					DP4 @O_TEX7.w, R4, c[$TEXMATRIX7+3];
				"
				*ifnot_TextureTrans7
				"
					DP4 @O_TEX7.x, $TEXINPUT7, c[$TEXMATRIX7+0];
					DP4 @O_TEX7.y, $TEXINPUT7, c[$TEXMATRIX7+1];
					DP4 @O_TEX7.z, $TEXINPUT7, c[$TEXMATRIX7+2];
					DP4 @O_TEX7.w, $TEXINPUT7, c[$TEXMATRIX7+3];
				"
			}

			*ifnot_texmatrix7
			{
				*if_TextureTrans7
				" 
					MUL R4, $TEXINPUT7, c[$TEXTURETRANS7];
					ADD @O_TEX7, R4, c[$TEXTURETRANS7+1];
				"
				*ifnot_TextureTrans7
				"
					MOV @O_TEX7, $TEXINPUT7;
				"
			}
		}

		*ifnot_texgen7_texcoord
		{
			*if_texgen7_linear
			"
				DP4 R3.x, R8, c[$TEXPARAM7+0];
				DP4 R3.y, R8, c[$TEXPARAM7+1];
				DP4 R3.z, R8, c[$TEXPARAM7+2];
				DP4 R3.w, R8, c[$TEXPARAM7+3];
			"

			*if_texgen7_linear_ms
			{
				*if_PosTrans
				"
					MUL R4, @V_POS, c[$POSTRANS];
					ADD R4, R4, c[$POSTRANS+1];
				"
				*ifnot_PosTrans
				"
					MOV R4, @V_POS;
				"

				*doeet
				"
					DP4 R3.x, R4, c[$TEXPARAM7+0];
					DP4 R3.y, R4, c[$TEXPARAM7+1];
					DP4 R3.z, R4, c[$TEXPARAM7+2];
					DP4 R3.w, R4, c[$TEXPARAM7+3];
				"
			}

			*if_texgen7_screen
			"
				MUL r4, c93, r12.w
				MAD r3, r12, c92, r4
			"

			*if_texgen7_normalmap
			"
				MOV R3, R9;
			"
			*if_texgen7_tang_u
			"
				MOV R3, R0;
			"
			*if_texgen7_tang_v
			"
				MOV R3, R1;
			"

			*if_texgen7_reflection
			"
				ADD R4, R8, c[$BASE+7];
				DP4 R3.x, R4, c[$BASE+4];
				DP4 R3.y, R4, c[$BASE+5];
				DP4 R3.z, R4, c[$BASE+6];
				MOV R3.w, c[$BASE+8].x;
				DP3 R4.x, R9, c[$BASE+4];
				DP3 R4.y, R9, c[$BASE+5];
				DP3 R4.z, R9, c[$BASE+6];
				MOV R4.w, c[$BASE+8].x;
				DP3 R3.w, -R3, R4;
				ADD R3.w, R3.w, R3.w;
				MUL R4, R4, R3.wwww;
				ADD R3, R3, R4;
				MOV R3.w, c[$BASE+8].x;
			"

			*if_texgen7_env
			{
				*if_TextureTrans7
				" 
					MUL R3, $TEXINPUT7, c[$TEXTURETRANS7];
					ADD R3, R3, c[$TEXTURETRANS7+1];
				"
				*ifnot_TextureTrans3
				"
					MOV R3, $TEXINPUT7;
				"
				*Post
				"
					MOV R3, $TEXINPUT7;
					DP3 R3.x, R9, c[$BASE+4];
					DP3 R3.y, -R9, c[$BASE+5];
					MUL R3, R3, c[$BASE+8].zzzz;
					ADD R3, R3, c[$BASE+8].zzzz;
				"
			}

	                /*
			*if_texgen7_Lighting
			"
				ADD R4, c[$TEXPARAM7+0], -R8;
				DP3 R3.w, R4, R4;
				RSQ R3.z, R3.w;
				RCP R3.z, R3.z;
				MUL R3.z, c[$TEXPARAM7+0].wwww, -R3.z;
				ADD R3.z, R3.z, c[$BASE+8].yyyy;
				MAX R3.z, R3.z, c[$BASE+8].x;
				MUL R4.w, R3.w, R3.z;
				MUL R4.xyz, R4, R4.w;
				MUL R3, c[$TEXPARAM7+1], R3.z;
			"
			*/
			*if_texgen7_Lighting_Nonormal
			"
				ADD R4, c[$TEXPARAM7+0], -R8;
				DP3 R3.w, R4, R4;
				RSQ R3.z, R3.w;
				RCP R3.z, R3.z;
				MUL R3.z, c[$TEXPARAM7+0].wwww, -R3.z;
				ADD R3.z, R3.z, c[$BASE+8].yyyy;
				MAX R3.z, R3.z, c[$BASE+8].x;
				MUL R3, c[$TEXPARAM7+1], R3.z;
			"

			*if_texgen7_Lighting
			"
				ADD R4, c[$TEXPARAM7+0], -R8;
				DP3 R3.w, R4, R4;
				RSQ R3.w, R3.w;
				RCP R3.z, R3.w;
				MUL R3.z, c[$TEXPARAM7+0].wwww, -R3.z;
				ADD R3.z, R3.z, c[$BASE+8].yyyy;
				MAX R3.z, R3.z, c[$BASE+8].x;
				MUL R4.w, R3.w, R3.z;
				MUL R4.xyz, R4, R4.w;
  			        DP3 R3.x, R9, R4;
  			        MAX R3.x, R3.x, c[$BASE+8].x;
  		 	        MUL R3.xyz, R3.xxxx, c[$TEXPARAM7+1];
  		 	        MOV R3.w, c[$BASE+8].y;
			"
			
			*if_texgen7_LightField
			"
                                MAX R5, R9,c[$BASE+8].xxxx;
                                MAX R4, -R9,c[$BASE+8].xxxx;
                                MUL R3.xyz, R4.x, c[$TEXPARAM7+0];
                                MAD R3.xyz, R4.y, c[$TEXPARAM7+2],R3;
                                MAD R3.xyz, R4.z, c[$TEXPARAM7+4],R3;
                                MAD R3.xyz, R5.x, c[$TEXPARAM7+1],R3;
                                MAD R3.xyz, R5.y, c[$TEXPARAM7+3],R3;
                                MAD R3.xyz, R5.z, c[$TEXPARAM7+5],R3;
                                
                                ADD R3, R3,R3;
                                MOV R3.w, c[$BASE+8].y;
			"

			*if_texgen7_tslv
			"
				ADD R4, c[$TEXPARAM7+0], -R8;
				DP3 R3.x, R9, R4;
				DP3 R3.y, R1, R4;
				DP3 R3.z, R0, R4;
				MUL R3.xyz, R3, c[$TEXPARAM7+0].wwww;
				MOV R3.w, c[$BASE+8].x;
			"

			*if_texgen7_depthoffset
			{
				*if_TextureTrans7
				" 
					MUL R5, $TEXINPUT7, c[$TEXTURETRANS7];
					ADD R5, R5, c[$TEXTURETRANS7+1];
				"
				*ifnot_TextureTrans7
				"
					MOV R5, $TEXINPUT7;
				"
				*Post
				"
				    SUB R3,c[$TEXPARAM7+0],R8;
				    DP3 R3.w,R3,R3;
				    RSQ R3.w,R3.w;
				    MUL R3,R3,R3.w;
				    DP3 R4.x,R3,R0;
				    DP3 R4.y,R3,R1;
				    DP3 R4.w,R3,R9;
				    RCP R4.w,R4.w;
				    MUL R3,R4,c[$TEXPARAM7+1];
				    MAD R3,R3,R4.w,R5;
				 "
			}

			*if_texgen7_mspos
			"
				MOV @O_TEX7, R8;
			"


			*if_texgen7_vspos
			"
				ADD R4, R8, c[$BASE+7];
				DP4 R3.x, R4, c[$BASE+4];
				DP4 R3.y, R4, c[$BASE+5];
				DP4 R3.z, R4, c[$BASE+6];
				MOV R3.w, c[$BASE+8].y;
			"

			*if_texgen7_constant
			"
				MOV @O_TEX7, c[$TEXPARAM7+0];
			"
			
			*ifnot_texgen7_constant {
			*ifnot_texgen7_mspos
			{
				*if_texmatrix7
				"
					DP4 @O_TEX7.x, R3, c[$TEXMATRIX7+0];
					DP4 @O_TEX7.y, R3, c[$TEXMATRIX7+1];
					DP4 @O_TEX7.z, R3, c[$TEXMATRIX7+2];
					DP4 @O_TEX7.w, R3, c[$TEXMATRIX7+3];
				"

				*ifnot_texmatrix7
				"
					MOV @O_TEX7, R3;
				"
			} }
		}
	}
	*end
	"
	@END
	"
}


