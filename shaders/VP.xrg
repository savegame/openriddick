			"
				DP4 R3.x, R8, c[$TEXPARAM6+0];
				DP4 R3.y, R8, c[$TEXPARAM6+1];
				DP4 R3.z, R8, c[$TEXPARAM6+2];
				DP4 R3.w, R8, c[$TEXPARAM6+3];
			"

